{
  "name": "mono-codex",
  "private": true,
  "version": "10.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit && node scripts/check-canon.mjs && node --experimental-strip-types --test tests/*.test.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/check-canon.mjs && node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
